; Cormant - demo. Proyecto Godot 4.7 (GDScript, todo en español).
config_version=5

[application]
config/name="Cormant"
config/description="Demo de terror psicológico point-and-click."
run/main_scene="res://escenas/titulo.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
Recursos="*res://scripts/nucleo/recursos.gd"
EstadoJuego="*res://scripts/nucleo/estado_juego.gd"
Sonido="*res://scripts/nucleo/sonido.gd"
Transicion="*res://scripts/nucleo/transicion.gd"
Director="*res://scripts/nucleo/director_eventos.gd"
Interfaz="*res://scripts/nucleo/interfaz.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
